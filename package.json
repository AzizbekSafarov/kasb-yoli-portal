{
  "name": "kasb-yoli", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0", "express": "^5.1.0", "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0", "lucide-react": "^0.468.0", "react": "^19.0.0", "react-dom": "^19.0.0", "zod": "^4.0.0"
  },
  "devDependencies": { "@playwright/test": "^1.56.0", "@vitejs/plugin-react": "^5.0.0", "concurrently": "^9.0.0", "vite": "^7.0.0" }
}
