# Local synthetic practice only. Render must use false + NODE_ENV=production.
DEMO_MODE=true
PORT=3001
APP_ORIGIN=http://localhost:3001
# Supabase Dashboard > Connect / API (public URL and publishable/anon key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server ONLY: needed for delivery status / durable notification outbox
SUPABASE_SERVICE_ROLE_KEY=
# Official Groq API. Model can be changed via configuration.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Server ONLY; synthetic application ID + course name, no user's goal or email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
